{
  "name": "opsmemory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:approval": "tsx scripts/test-approval.ts",
    "check:llm": "tsx --env-file=.env.local scripts/check-llm.ts",
    "spike:meko": "tsx --env-file=.env.local scripts/spike-meko.ts",
    "check:scopes": "tsx --env-file=.env.local scripts/check-scopes.ts",
    "bench:llm": "tsx --env-file=.env.local scripts/bench-llm.ts",
    "ops": "tsx --env-file=.env.local scripts/ops.ts",
    "e2e": "tsx --env-file=.env.local scripts/e2e.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:rehearse": "MEKO_DATAPACK_PREFIX=opsmemory-e2e OPSMEMORY_DB=data/ui-rehearsal.db next dev -p 3100",
    "demo:reset": "tsx --env-file=.env.local scripts/demo-reset.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
