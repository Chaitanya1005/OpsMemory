# Meko — create a key at https://cloud.mekodata.ai (Settings > API Keys).
# Use a key dedicated to this app, not your coding agent's key.
MEKO_API_KEY=

# Datapacks are <prefix>-knowledge and <prefix>-investigator.
MEKO_DATAPACK_PREFIX=opsmemory
# true creates them on the first Meko ON run if they don't exist yet. Set false afterwards,
# so a mistyped prefix fails clearly instead of silently starting with empty datapacks.
MEKO_CREATE_DATAPACKS=true

# LLM provider: "gemini" (Groq fallback planned).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# gemini-3.5-flash-lite answered in ~2s in testing; gemini-3.8-flash took 90-140s per call on the free tier.
GEMINI_MODEL=gemini-3.5-flash-lite
# MINIMAL | LOW | MEDIUM | HIGH
GEMINI_THINKING_LEVEL=LOW
